<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft ion-blue glow halo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="#1660A5FA" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="22dp" />
        </shape>
    </item>
    <!-- Mid glow bloom -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.5dp"
                android:color="#337DD3FC" />
            <corners
                android:topLeftRadius="20.5dp"
                android:topRightRadius="20.5dp"
                android:bottomLeftRadius="6.5dp"
                android:bottomRightRadius="20.5dp" />
        </shape>
    </item>
    <!-- Semi-transparent dark smoked frosted glass fill -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#80112040"
                android:endColor="#5C0D1830"
                android:type="linear" />
            <corners
                android:topLeftRadius="19dp"
                android:topRightRadius="19dp"
                android:bottomLeftRadius="5dp"
                android:bottomRightRadius="19dp" />
        </shape>
    </item>
    <!-- Top specular glass reflection & luminous rim -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1EFFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.1dp"
                android:color="@color/bubble_received_border" />
            <corners
                android:topLeftRadius="19dp"
                android:topRightRadius="19dp"
                android:bottomLeftRadius="5dp"
                android:bottomRightRadius="19dp" />
        </shape>
    </item>
</layer-list>
