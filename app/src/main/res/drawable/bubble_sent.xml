<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft cyan glow halo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="#1A00F0FF" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="22dp"
                android:bottomRightRadius="8dp" />
        </shape>
    </item>
    <!-- Mid glow bloom -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.5dp"
                android:color="#3D00F0FF" />
            <corners
                android:topLeftRadius="20.5dp"
                android:topRightRadius="20.5dp"
                android:bottomLeftRadius="20.5dp"
                android:bottomRightRadius="6.5dp" />
        </shape>
    </item>
    <!-- Semi-transparent frosted glass fill -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/bubble_sent_start"
                android:endColor="@color/bubble_sent_end"
                android:type="linear" />
            <corners
                android:topLeftRadius="19dp"
                android:topRightRadius="19dp"
                android:bottomLeftRadius="19dp"
                android:bottomRightRadius="5dp" />
        </shape>
    </item>
    <!-- Top specular glass reflection & crisp luminous edge -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#29FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#9900F0FF" />
            <corners
                android:topLeftRadius="19dp"
                android:topRightRadius="19dp"
                android:bottomLeftRadius="19dp"
                android:bottomRightRadius="5dp" />
        </shape>
    </item>
</layer-list>
