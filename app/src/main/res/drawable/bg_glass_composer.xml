<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="#1C00F0FF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#BF111D38"
                android:endColor="#A6091124"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#6600F0FF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
