<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingHorizontal="12dp" android:paddingVertical="10dp"
    android:background="?attr/selectableItemBackground" android:layout_marginVertical="3dp">
    <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
        <TextView android:id="@+id/tvAvatarInitial" android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:textSize="18sp" android:textColor="@color/text_on_primary"
            android:fontFamily="sans-serif-medium" android:background="@drawable/circle_green_avatar" android:text="L"/>
        <View android:layout_width="12dp" android:layout_height="12dp"
            android:layout_gravity="bottom|end" android:background="@drawable/online_dot"/>
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvDeviceName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" android:text="LANVOX-Device"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
            <ImageView android:id="@+id/ivSignalIcon" android:layout_width="13dp" android:layout_height="13dp"
                android:src="@drawable/ic_signal_strong" android:contentDescription="Signal strength"
                android:tint="@color/brand_secondary" android:layout_marginEnd="4dp"/>
            <TextView android:id="@+id/tvDeviceStatus" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="12sp" android:textColor="@color/text_secondary"
                android:maxLines="1" android:ellipsize="end" android:text="8m · Strong signal"/>
        </LinearLayout>
        <TextView android:id="@+id/tvDeviceInfo2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/text_tertiary" android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPeerCall"
            android:layout_width="36dp" android:layout_height="36dp" android:insetTop="0dp"
            android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"
            app:cornerRadius="18dp" app:backgroundTint="@color/brand_secondary"
            app:icon="@drawable/ic_phone" app:iconGravity="textStart" app:iconPadding="0dp"
            app:iconTint="@color/text_on_primary" app:iconSize="18dp" android:layout_marginBottom="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPeerVideo"
            android:layout_width="36dp" android:layout_height="36dp" android:insetTop="0dp"
            android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"
            app:cornerRadius="18dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/brand_secondary" app:strokeWidth="1.5dp"
            app:icon="@drawable/ic_videocam" app:iconGravity="textStart" app:iconPadding="0dp"
            app:iconTint="@color/brand_secondary" app:iconSize="18dp"/>
    </LinearLayout>
</LinearLayout>
