<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:background="@drawable/bg_glass_card"
    android:layout_marginVertical="4dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <TextView
            android:id="@+id/tvAvatarInitial"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_primary"
            android:fontFamily="@font/space_grotesk"
            android:background="@drawable/circle_green_avatar"
            android:text="L" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/online_dot" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/space_grotesk"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="LanVox-Device" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <ImageView
                android:id="@+id/ivSignalIcon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_signal_strong"
                android:contentDescription="Signal strength"
                android:tint="@color/status_online"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/tvDeviceStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Available · Strong signal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDeviceInfo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPeerCall"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/btn_audio_call"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="21dp"
            app:backgroundTint="@color/brand_secondary"
            app:icon="@drawable/ic_phone"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/text_on_primary"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPeerVideo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/btn_video_call"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="21dp"
            app:backgroundTint="@color/encrypted_bg"
            app:strokeColor="@color/glass_border_active"
            app:strokeWidth="1.2dp"
            app:icon="@drawable/ic_videocam"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/brand_secondary"
            app:iconSize="18dp" />
    </LinearLayout>
</LinearLayout>
