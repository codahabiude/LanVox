<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Luminous Drag Handle -->
    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/dot_inactive" />

    <!-- Holographic Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="10dp"
            android:clipChildren="false">

            <View
                android:id="@+id/sheetRadarPulse"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/pulse_ring"
                android:visibility="invisible" />

            <com.example.wifip2pchat.RadarView
                android:id="@+id/sheetRadarView"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk"
                android:textStyle="bold"
                android:text="@string/sheet_peers_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSheetSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="@string/sheet_peers_hint_idle"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSheetClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/cd_close"
            android:padding="13dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Scanning Progress -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressSheetScanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/brand_secondary"
        app:trackColor="@color/surface_card"
        app:trackCornerRadius="4dp"
        app:trackThickness="3dp" />

    <!-- Glass Peers Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="312dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSheetPeers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/llSheetPeersEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="228dp"
                    android:layout_height="122dp"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false">

                        <ImageView
                            android:id="@+id/ivSheetEmptyIllustration"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha="0.92"
                            android:contentDescription="@string/cd_empty_peers_illustration"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_no_peers_empty" />

                        <View
                            android:id="@+id/sheetEmptyPulseRing"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:layout_gravity="center"
                            android:background="@drawable/pulse_ring"
                            android:visibility="invisible" />

                        <com.example.wifip2pchat.RadarView
                            android:id="@+id/sheetEmptyRadarView"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:layout_gravity="center"
                            android:background="@drawable/radar_bg" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvSheetEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/sheet_peers_empty_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSheetEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/sheet_peers_empty_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSheetEmptyScan"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:fontFamily="@font/space_grotesk"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="168dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/btn_start_scan"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/brand_secondary"
                    app:cornerRadius="999dp"
                    app:icon="@drawable/ic_search"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/text_on_primary" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetScan"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:fontFamily="@font/space_grotesk"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_scan"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:textSize="14sp"
            app:backgroundTint="@color/brand_secondary"
            app:cornerRadius="999dp"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/text_on_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetDisconnect"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/space_grotesk"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="18dp"
            android:text="@string/btn_disconnect"
            android:textAllCaps="false"
            android:textColor="@color/brand_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            app:cornerRadius="999dp"
            app:strokeColor="@color/glass_border_active"
            app:strokeWidth="1.5dp" />
    </LinearLayout>
</LinearLayout>
