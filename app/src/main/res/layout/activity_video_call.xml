<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/videoCallRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/surfaceRemote"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLocalPreview"
        android:layout_width="118dp"
        android:layout_height="162dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="14dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/glass_border_active"
        app:strokeWidth="1.5dp">

        <SurfaceView
            android:id="@+id/surfaceLocal"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Top HUD & Active Call Timer Overlay -->
    <LinearLayout
        android:id="@+id/videoTopOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:background="@drawable/call_gradient_top_overlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/encrypted_short"
                android:textSize="10sp"
                android:textColor="@color/brand_secondary"
                android:fontFamily="@font/jetbrains_mono"
                android:background="@drawable/pill_green_small"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/layoutCallTimerOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_timer_overlay_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:elevation="4dp"
                android:contentDescription="@string/cd_call_timer_overlay">

                <View
                    android:id="@+id/viewTimerDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_timer_dot" />

                <TextView
                    android:id="@+id/tvTimerState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_timer_connecting"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/status_discovering"
                    android:fontFamily="@font/jetbrains_mono"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvCallDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_timer_default"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/jetbrains_mono" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="Connected Peer"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/space_grotesk"
            android:shadowColor="#80000000"
            android:shadowRadius="4" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/videoBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="24dp"
        android:background="@drawable/call_gradient_bottom_overlay">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMute"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/mute"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="26dp"
            app:backgroundTint="@color/hud_surface"
            app:strokeColor="@color/glass_border_active"
            app:strokeWidth="1.5dp"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/brand_secondary"
            app:iconSize="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEndCall"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/end_call"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="32dp"
            app:backgroundTint="@color/call_decline"
            app:icon="@drawable/ic_phone_off"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/text_primary"
            app:iconSize="26dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/switch_camera"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="26dp"
            app:backgroundTint="@color/hud_surface"
            app:strokeColor="@color/glass_border_active"
            app:strokeWidth="1.5dp"
            app:icon="@drawable/ic_camera_flip"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/brand_secondary"
            app:iconSize="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeaker"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/speaker_on"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="26dp"
            app:backgroundTint="@color/hud_surface"
            app:strokeColor="@color/glass_border_active"
            app:strokeWidth="1.5dp"
            app:icon="@drawable/ic_volume"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/brand_secondary"
            app:iconSize="22dp" />
    </LinearLayout>
</FrameLayout>
