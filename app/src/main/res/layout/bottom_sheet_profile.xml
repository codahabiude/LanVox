<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/dot_inactive" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk"
                android:text="@string/profile_sheet_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/profile_sheet_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnProfileClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close"
            android:padding="13dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Avatar Preview & Photo Picker Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginEnd="14dp">

            <TextView
                android:id="@+id/tvProfileAvatarInitial"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/circle_green_avatar"
                android:fontFamily="@font/space_grotesk"
                android:gravity="center"
                android:text="L"
                android:textColor="@color/text_on_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivProfileAvatarPreview"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:contentDescription="@string/cd_profile_avatar"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickAvatar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/space_grotesk"
                android:insetTop="2dp"
                android:insetBottom="2dp"
                android:text="@string/profile_choose_photo"
                android:textAllCaps="false"
                android:textColor="@color/text_on_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_secondary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_gallery"
                app:iconGravity="textStart"
                app:iconSize="17dp"
                app:iconTint="@color/text_on_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveAvatar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/space_grotesk"
                android:insetTop="2dp"
                android:insetBottom="2dp"
                android:text="@string/profile_remove_photo"
                android:textAllCaps="false"
                android:textColor="@color/call_decline"
                android:textSize="12.5sp"
                android:visibility="gone"
                app:cornerRadius="12dp"
                app:strokeColor="@color/call_decline"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Display Name & Bio Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:text="@string/profile_label_name"
            android:textColor="@color/brand_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_glass_composer"
            android:fontFamily="@font/plus_jakarta_sans"
            android:hint="@string/diag_nickname_hint"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="32"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/jetbrains_mono"
            android:text="@string/profile_label_status"
            android:textColor="@color/brand_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipStatusAvailable"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_reaction_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/space_grotesk"
                android:gravity="center"
                android:text="@string/status_preset_available"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipStatusBusy"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_reaction_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/space_grotesk"
                android:gravity="center"
                android:text="@string/status_preset_busy"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipStatusAway"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_reaction_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/space_grotesk"
                android:gravity="center"
                android:text="@string/status_preset_away"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/jetbrains_mono"
            android:text="@string/profile_label_bio"
            android:textColor="@color/brand_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_glass_composer"
            android:fontFamily="@font/plus_jakarta_sans"
            android:hint="@string/profile_bio_hint"
            android:inputType="textCapSentences"
            android:maxLength="80"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13.5sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProfileSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:fontFamily="@font/space_grotesk"
        android:text="@string/profile_save_sync"
        android:textAllCaps="false"
        android:textColor="@color/text_on_primary"
        android:textSize="14.5sp"
        android:textStyle="bold"
        app:backgroundTint="@color/brand_secondary"
        app:cornerRadius="14dp" />
</LinearLayout>
