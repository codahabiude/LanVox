<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jetbrains_mono"
        android:text="@string/poll_label_question"
        android:textColor="@color/brand_secondary"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etPollQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_composer"
        android:fontFamily="@font/plus_jakarta_sans"
        android:hint="@string/poll_hint_question"
        android:inputType="textCapSentences"
        android:maxLength="120"
        android:minHeight="48dp"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jetbrains_mono"
        android:text="@string/poll_label_options"
        android:textColor="@color/brand_secondary"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etPollOpt1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_composer"
        android:fontFamily="@font/plus_jakarta_sans"
        android:hint="@string/poll_hint_opt1"
        android:inputType="textCapSentences"
        android:maxLength="60"
        android:maxLines="1"
        android:minHeight="44dp"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="13.5sp" />

    <EditText
        android:id="@+id/etPollOpt2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_composer"
        android:fontFamily="@font/plus_jakarta_sans"
        android:hint="@string/poll_hint_opt2"
        android:inputType="textCapSentences"
        android:maxLength="60"
        android:maxLines="1"
        android:minHeight="44dp"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="13.5sp" />

    <EditText
        android:id="@+id/etPollOpt3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_composer"
        android:fontFamily="@font/plus_jakarta_sans"
        android:hint="@string/poll_hint_opt3"
        android:inputType="textCapSentences"
        android:maxLength="60"
        android:maxLines="1"
        android:minHeight="44dp"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="13.5sp" />

    <EditText
        android:id="@+id/etPollOpt4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_composer"
        android:fontFamily="@font/plus_jakarta_sans"
        android:hint="@string/poll_hint_opt4"
        android:inputType="textCapSentences"
        android:maxLength="60"
        android:maxLines="1"
        android:minHeight="44dp"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="13.5sp" />
</LinearLayout>
