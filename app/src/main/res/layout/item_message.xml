<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="10dp"
    android:paddingVertical="5dp">

    <!-- Centered Call History Timeline Pill -->
    <LinearLayout
        android:id="@+id/layoutCallLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="4dp"
        android:background="@drawable/bg_glass_thread_bar"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivCallLogIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/btn_audio_call"
            android:src="@drawable/ic_phone"
            android:tint="@color/brand_secondary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCallLogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCallLogMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCallLogCallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/pill_green_small"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/space_grotesk"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/call_log_callback"
            android:textColor="@color/brand_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/messageColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/bubbleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bubble_received"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="11dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/tvSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/space_grotesk"
                android:maxWidth="260dp"
                android:maxLines="1"
                android:textColor="@color/brand_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Quote-Reply Block (WhatsApp / IG / Messenger style) -->
            <LinearLayout
                android:id="@+id/layoutReplyQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="170dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_quote_reply"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingVertical="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:background="@color/brand_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvQuoteSender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_grotesk"
                        android:maxWidth="220dp"
                        android:maxLines="1"
                        android:textColor="@color/brand_secondary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuoteText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:maxWidth="220dp"
                        android:maxLines="2"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAttachment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_attachment_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:minWidth="240dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFilePreview"
                    android:layout_width="244dp"
                    android:layout_height="144dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/brand_primary"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivFilePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_attach_file"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_glass_circle">

                        <ImageView
                            android:id="@+id/ivFileTypeIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_attach_file"
                            android:src="@drawable/ic_file_doc"
                            android:tint="@color/brand_secondary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:fontFamily="@font/space_grotesk"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFileMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/jetbrains_mono"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFileProgressBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/jetbrains_mono"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/brand_secondary"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressFileTransfer"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/brand_secondary"
                        app:indicatorSize="18dp"
                        app:trackColor="@color/encrypted_bg"
                        app:trackThickness="2.5dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutTransferProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/linearFileProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="@color/brand_secondary"
                        app:trackColor="@color/encrypted_bg"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="5dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTransferStage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/jetbrains_mono"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvTransferPeerCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llPeerTransferChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Inline Push-to-Talk Voice Note Player -->
            <LinearLayout
                android:id="@+id/layoutVoiceNote"
                android:layout_width="236dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnVoicePlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_glass_circle"
                    android:clickable="true"
                    android:contentDescription="@string/cd_voice_play"
                    android:focusable="true"
                    android:padding="13dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/brand_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <SeekBar
                        android:id="@+id/seekVoiceNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="1000"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:progressTint="@color/brand_secondary"
                        android:thumbTint="@color/brand_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvVoiceDuration"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="00:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tvVoiceStateBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="VOICE"
                            android:textColor="@color/brand_secondary"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Interactive Live Poll Card -->
            <LinearLayout
                android:id="@+id/layoutPollCard"
                android:layout_width="244dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/cd_create_poll"
                        android:src="@drawable/ic_poll"
                        android:tint="@color/brand_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:letterSpacing="0.08"
                        android:text="LIVE POLL"
                        android:textColor="@color/brand_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPollQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/llPollOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvPollMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:lineSpacingExtra="3dp"
                android:maxWidth="276dp"
                android:text="Hello"
                android:textColor="@color/bubble_received_text"
                android:textSize="14.5sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPinnedBadge"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/action_pin_message"
                    android:src="@drawable/ic_push_pin"
                    android:tint="@color/brand_secondary"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivStarred"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/action_star_message"
                    android:src="@drawable/ic_star"
                    android:tint="@color/status_discovering"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvExpiryTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/status_discovering"
                    android:textSize="9.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEditedTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="@string/msg_edited_tag"
                    android:textColor="@color/bubble_received_time"
                    android:textSize="9.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:letterSpacing="0.02"
                    android:text="12:34"
                    android:textColor="@color/bubble_received_time"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/ivTick"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="5dp"
                    android:contentDescription="Sent"
                    android:src="@drawable/ic_check"
                    android:tint="@color/tick_sent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvReadStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:letterSpacing="0.02"
                    android:textColor="@color/tick_sent"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Emoji Reactions Pill Bar (IG / WhatsApp / Messenger style) -->
        <LinearLayout
            android:id="@+id/llReactionsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="-6dp"
            android:layout_marginHorizontal="8dp"
            android:elevation="3dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
