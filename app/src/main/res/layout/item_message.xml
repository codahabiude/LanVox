<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="10dp"
    android:paddingVertical="5dp">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bubble_received"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="11dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/tvSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:fontFamily="@font/space_grotesk"
            android:textStyle="bold"
            android:maxWidth="260dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/brand_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:lineSpacingExtra="3dp"
            android:maxWidth="276dp"
            android:text="Hello"
            android:textColor="@color/bubble_received_text"
            android:textIsSelectable="true"
            android:textSize="14.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono"
                android:letterSpacing="0.02"
                android:text="12:34"
                android:textColor="@color/bubble_received_time"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/ivTick"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="5dp"
                android:contentDescription="Sent"
                android:src="@drawable/ic_check"
                android:tint="@color/tick_sent"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
