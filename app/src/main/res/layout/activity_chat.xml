<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/top_bar_bg"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/btnChatBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="13dp"
            android:tint="@color/text_primary"
            android:layout_marginEnd="4dp" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/tvChatAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_primary"
                android:fontFamily="@font/space_grotesk"
                android:background="@drawable/circle_green_avatar" />

            <ImageView
                android:id="@+id/ivChatAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_profile_avatar"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <View
                android:id="@+id/viewChatPresenceDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/online_dot" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="4dp">

            <TextView
                android:id="@+id/tvChatPeerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/space_grotesk"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvChatPeerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="11sp"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/brand_secondary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnChatEphemeral"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_timer"
            android:contentDescription="@string/cd_ephemeral_timer"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="13dp"
            android:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/btnChatSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/cd_search_messages"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="13dp"
            android:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/btnChatAudioCall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_phone"
            android:contentDescription="Audio call"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="13dp"
            android:tint="@color/brand_secondary" />

        <ImageView
            android:id="@+id/btnChatVideoCall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_videocam"
            android:contentDescription="Video call"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="13dp"
            android:tint="@color/brand_secondary" />
    </LinearLayout>

    <!-- Slim Thread Utility Strip (Nudge, Poll, Shared Media Gallery) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_thread_strip"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/pillChatNudge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_reaction_chip"
                android:clickable="true"
                android:contentDescription="@string/cd_nudge_peer"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@string/cd_nudge_peer"
                    android:src="@drawable/ic_bolt"
                    android:tint="@color/status_discovering" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:text="Nudge"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pillChatPoll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_reaction_chip"
                android:clickable="true"
                android:contentDescription="@string/cd_create_poll"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@string/cd_create_poll"
                    android:src="@drawable/ic_poll"
                    android:tint="@color/brand_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/action_create_poll"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pillChatGallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_reaction_chip"
                android:clickable="true"
                android:contentDescription="@string/cd_media_gallery"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@string/cd_media_gallery"
                    android:src="@drawable/ic_gallery"
                    android:tint="@color/status_online" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/action_media_gallery"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Pinned Message Frosted Banner -->
    <LinearLayout
        android:id="@+id/layoutPinnedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_thread_bar"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/action_pin_message"
            android:src="@drawable/ic_push_pin"
            android:tint="@color/brand_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPinnedSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/space_grotesk"
                android:maxLines="1"
                android:textColor="@color/brand_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPinnedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnUnpinBanner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_unpin_banner"
            android:padding="14dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:background="@drawable/chat_wallpaper_tile">

        <!-- Ambient Luminous Light Orbs (blurred via RenderEffect on API 31+) -->
        <View
            android:id="@+id/ambientOrb1"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="-64dp"
            android:background="@drawable/ambient_orb_cyan" />

        <View
            android:id="@+id/ambientOrb2"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="-90dp"
            android:background="@drawable/ambient_orb_violet" />

        <View
            android:id="@+id/ambientOrb3"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-48dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/ambient_orb_cyan" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="6dp"
            android:paddingTop="14dp"
            android:paddingBottom="88dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/llSearchEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="36dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_circle">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search_empty_title"
                    android:tint="@color/brand_secondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSearchEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_empty_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/space_grotesk"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSearchEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/search_empty_subtitle"
                android:textSize="12.5sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Floating Frosted Glass Search Bar -->
        <LinearLayout
            android:id="@+id/searchBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_glass_thread_bar"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:paddingVertical="2dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/cd_search_messages"
                android:tint="@color/brand_secondary" />

            <EditText
                android:id="@+id/etSearchMessages"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:hint="@string/hint_search_messages"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:singleLine="true"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:fontFamily="@font/plus_jakarta_sans"
                android:background="@android:color/transparent"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/tvFilterStarred"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_reaction_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/jetbrains_mono"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="@string/filter_starred"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvSearchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/pill_green_small"
                android:fontFamily="@font/jetbrains_mono"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/brand_secondary"
                android:textSize="10sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnCloseSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close"
                android:padding="14dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:clipChildren="false">

            <TextView
                android:id="@+id/tvTypingPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_reaction_chip"
                android:fontFamily="@font/jetbrains_mono"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="@string/typing_single"
                android:textColor="@color/status_online"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutReplyPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_glass_thread_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/brand_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReplyPreviewSender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_grotesk"
                        android:maxLines="1"
                        android:textColor="@color/brand_secondary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReplyPreviewText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnCancelReply"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_cancel_reply"
                    android:padding="14dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Push-to-Talk Voice Recording Bar -->
            <LinearLayout
                android:id="@+id/layoutVoiceRecording"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_glass_thread_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/circle_red" />

                <TextView
                    android:id="@+id/tvVoiceRecordTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="REC 00:00"
                    android:textColor="@color/call_decline"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressVoiceAmp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="20"
                    app:indicatorColor="@color/brand_secondary"
                    app:trackColor="@color/encrypted_bg"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="4dp" />

                <ImageView
                    android:id="@+id/btnVoiceCancel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_voice_cancel"
                    android:padding="13dp"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/call_decline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVoiceSend"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/cd_voice_send"
                    android:insetTop="2dp"
                    android:insetBottom="2dp"
                    android:insetLeft="2dp"
                    android:insetRight="2dp"
                    app:backgroundTint="@color/brand_secondary"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/text_on_primary" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/hsvQuickReplies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llQuickReplyChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="2dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/composerDock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="6dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_glass_composer">

                <ImageView
                    android:id="@+id/btnAttach"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_attach_file"
                    android:padding="13dp"
                    android:src="@drawable/ic_attach"
                    android:tint="@color/brand_secondary" />

                <ImageView
                    android:id="@+id/btnVoiceNote"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_voice_note"
                    android:padding="13dp"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/brand_secondary" />

                <ImageView
                    android:id="@+id/btnQuickReplies"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_quick_replies"
                    android:padding="13dp"
                    android:src="@drawable/ic_bolt"
                    android:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="46dp"
                    android:hint="@string/hint_message"
                    android:inputType="text|textCapSentences"
                    android:maxLines="3"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:background="@android:color/transparent"
                    android:paddingVertical="10dp"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSend"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="@string/cd_send_message"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    app:cornerRadius="23dp"
                    app:backgroundTint="@color/brand_secondary"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="19dp"
                    app:iconTint="@color/text_on_primary" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
