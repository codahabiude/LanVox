<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/brand_primary">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/top_bar_bg" android:paddingHorizontal="8dp" android:paddingVertical="8dp">
        <ImageView android:id="@+id/btnChatBack" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_back" android:contentDescription="Back"
            android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp"
            android:tint="@color/text_secondary" android:layout_marginEnd="4dp"/>
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="10dp">
            <TextView android:id="@+id/tvChatAvatar" android:layout_width="40dp" android:layout_height="40dp"
                android:gravity="center" android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/text_on_primary" android:fontFamily="sans-serif-medium"
                android:background="@drawable/circle_green_avatar"/>
            <View android:layout_width="11dp" android:layout_height="11dp"
                android:layout_gravity="bottom|end" android:background="@drawable/online_dot"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/tvChatPeerName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/tvChatPeerStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textColor="@color/brand_secondary" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <ImageView android:id="@+id/btnChatAudioCall" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_phone" android:contentDescription="Audio call"
            android:background="?attr/selectableItemBackgroundBorderless" android:padding="7dp"
            android:tint="@color/text_secondary" android:layout_marginEnd="4dp"/>
        <ImageView android:id="@+id/btnChatVideoCall" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_videocam" android:contentDescription="Video call"
            android:background="?attr/selectableItemBackgroundBorderless" android:padding="7dp"
            android:tint="@color/text_secondary"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMessages"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingHorizontal="6dp" android:paddingTop="10dp" android:paddingBottom="6dp"
        android:clipToPadding="false" android:scrollbars="none" android:background="@drawable/chat_wallpaper_tile"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="8dp" android:paddingVertical="8dp" android:background="@drawable/top_bar_bg">
        <EditText android:id="@+id/etMessage" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="@string/hint_message" android:inputType="text|textCapSentences"
            android:maxLines="3" android:textSize="14sp" android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary" android:fontFamily="sans-serif"
            android:background="@drawable/chat_input_bg" android:paddingHorizontal="16dp"
            android:paddingVertical="12dp" android:layout_marginEnd="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSend"
            android:layout_width="44dp" android:layout_height="44dp" android:insetTop="0dp"
            android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"
            app:cornerRadius="22dp" app:backgroundTint="@color/brand_secondary"
            app:icon="@drawable/ic_send" app:iconGravity="textStart" app:iconPadding="0dp"
            app:iconSize="20dp" app:iconTint="@color/text_on_primary"/>
    </LinearLayout>
</LinearLayout>
