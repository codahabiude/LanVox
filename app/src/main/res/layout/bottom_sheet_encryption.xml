<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/dot_inactive" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/enc_sheet_title"
                android:padding="9dp"
                android:src="@drawable/ic_shield"
                android:tint="@color/status_online" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/enc_sheet_title"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="@string/enc_sheet_subtitle"
                    android:textColor="@color/brand_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnEncClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close"
                android:padding="13dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Active 6-Layer Protection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvEncSelfFingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_reaction_chip"
                android:fontFamily="@font/jetbrains_mono"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textColor="@color/brand_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/enc_layer_vault"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/enc_layer_chat"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/enc_layer_files"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/enc_layer_calls"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/enc_layer_storage"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Peer Safety Number Verification Card -->
        <LinearLayout
            android:id="@+id/cardEncSafety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEncPeerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="@string/enc_safety_header"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEncPeerStatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_green_small"
                    android:fontFamily="@font/jetbrains_mono"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/status_online"
                    android:textSize="10.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEncKeyChangedBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_reaction_chip"
                android:fontFamily="@font/plus_jakarta_sans"
                android:padding="10dp"
                android:textColor="@color/status_discovering"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEncSafetyInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvEncSafetyNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_reaction_chip"
                android:fontFamily="@font/jetbrains_mono"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:lineSpacingMultiplier="1.35"
                android:paddingVertical="12dp"
                android:paddingHorizontal="10dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Multi-peer selector list when opened from Group Chat -->
            <LinearLayout
                android:id="@+id/llEncPeerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Actions Row -->
            <LinearLayout
                android:id="@+id/llEncVerifyActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEncVerifyToggle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/enc_btn_mark_verified"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary"
                    android:textStyle="bold"
                    app:backgroundTint="@color/brand_secondary"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEncCopy"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/enc_btn_copy"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_secondary"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/glass_border_active" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
