<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_primary">

    <!-- Top App & Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/top_bar_bg"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_brand_logo"
                android:contentDescription="LANVOX"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LANVOX"
                android:textSize="20sp"
                android:textColor="@color/brand_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

            <ImageView
                android:id="@+id/btnChats"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_chats"
                android:contentDescription="Open chats list"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/btnExportChat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_save"
                android:contentDescription="Export chat history to file"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/btnClearHistory"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="Clear chat history"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvDeviceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_red" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/status_disabled"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressConnecting"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/brand_secondary"
                app:trackColor="@color/encrypted_bg"
                app:trackThickness="2dp"
                app:indicatorSize="18dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStoragePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_offline_mode"
            android:textSize="11sp"
            android:textColor="@color/brand_secondary"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/pill_green_small"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="6dp" />

        <!-- Quick Wi-Fi Direct Discovery & Call Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiscover"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_discover"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/text_on_primary"
                android:fontFamily="sans-serif-medium"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:paddingHorizontal="10dp"
                app:cornerRadius="999dp"
                app:backgroundTint="@color/brand_secondary"
                app:icon="@drawable/ic_search"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconPadding="6dp"
                app:iconTint="@color/text_on_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleDevices"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_devices"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/brand_secondary"
                android:fontFamily="sans-serif-medium"
                android:contentDescription="@string/cd_toggle_scanner"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:paddingHorizontal="12dp"
                app:cornerRadius="999dp"
                app:strokeColor="@color/brand_secondary"
                app:strokeWidth="1.2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudioCall"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/btn_audio_call"
                android:enabled="false"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/brand_secondary"
                app:icon="@drawable/ic_phone"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_on_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVideoCall"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/btn_video_call"
                android:enabled="false"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/brand_secondary"
                app:icon="@drawable/ic_videocam"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_on_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Collapsible Radar & Nearby Devices Panel -->
    <LinearLayout
        android:id="@+id/scannerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/brand_primary_variant"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginEnd="14dp">

                <com.example.wifip2pchat.RadarView
                    android:id="@+id/radarView"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOU"
                    android:textSize="9sp"
                    android:textColor="@color/brand_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_scanner"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvScanHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_enabled"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisconnect"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/btn_disconnect"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="@color/brand_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="4dp"
                    android:insetBottom="4dp"
                    app:cornerRadius="999dp"
                    app:strokeColor="@color/brand_secondary"
                    app:strokeWidth="1.2dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_devices"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_card">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPeers"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:clipToPadding="false"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/tvPeersEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="No devices nearby yet.\nTap Discover to scan."
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary"
                    android:lineSpacingExtra="3dp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Active Chat Thread Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_card"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="@string/encrypted"
            android:tint="@color/brand_secondary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvActiveChatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_group_chat"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvActiveChatSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_offline_local"
            android:textSize="11sp"
            android:textColor="@color/brand_secondary"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- RecyclerView Chat Messages Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/chat_wallpaper_tile">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="6dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/llMessagesEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_chats"
                android:contentDescription="@string/chat_empty_title"
                android:tint="@color/text_tertiary"
                android:alpha="0.7"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_empty_title"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/chat_empty_subtitle"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Chat Input Field + Send Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:background="@drawable/top_bar_bg">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:hint="@string/hint_message"
            android:inputType="text|textCapSentences"
            android:imeOptions="actionSend"
            android:maxLines="3"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:fontFamily="sans-serif"
            android:background="@drawable/chat_input_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_send_message"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/brand_secondary"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/text_on_primary" />
    </LinearLayout>
</LinearLayout>
