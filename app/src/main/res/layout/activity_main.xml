<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/brand_primary">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/top_bar_bg"
        android:paddingHorizontal="16dp" android:paddingTop="14dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_brand_logo" android:contentDescription="LANVOX" android:layout_marginEnd="10dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="LANVOX" android:textSize="20sp" android:textColor="@color/brand_secondary"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"/>
            <ImageView android:id="@+id/btnChats" android:layout_width="36dp" android:layout_height="36dp"
                android:src="@drawable/ic_chats" android:contentDescription="Open chats list"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="6dp"
                android:tint="@color/text_secondary" android:layout_marginEnd="4dp"/>
            <ImageView android:id="@+id/btnExportChat" android:layout_width="36dp" android:layout_height="36dp"
                android:src="@drawable/ic_save" android:contentDescription="Export chat history to file"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="7dp"
                android:tint="@color/text_secondary" android:layout_marginEnd="4dp"/>
            <ImageView android:id="@+id/btnClearHistory" android:layout_width="36dp" android:layout_height="36dp"
                android:src="@drawable/ic_delete" android:contentDescription="Clear chat history"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="7dp"
                android:tint="@color/text_secondary"/>
            <TextView android:id="@+id/tvDeviceInfo" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="11sp"
                android:textColor="@color/text_tertiary" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <View android:id="@+id/statusIndicator" android:layout_width="8dp" android:layout_height="8dp"
                android:background="@drawable/circle_red"/>
            <TextView android:id="@+id/tvStatus" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/status_disabled"
                android:textSize="12sp" android:textColor="@color/text_secondary"/>
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressConnecting" android:layout_width="18dp" android:layout_height="18dp"
                android:indeterminate="true" android:visibility="gone"
                app:indicatorColor="@color/brand_secondary" app:trackColor="@color/encrypted_bg"
                app:trackThickness="2dp" app:indicatorSize="18dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvStoragePill" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/status_offline_mode" android:textSize="11sp" android:textColor="@color/brand_secondary"
            android:fontFamily="sans-serif-medium" android:background="@drawable/pill_green_small"
            android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:layout_marginTop="8dp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="16dp"
            android:paddingBottom="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/section_scanner" android:textSize="18sp"
                android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/tvScanHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/status_discovering" android:textSize="13sp"
                android:textColor="@color/text_secondary" android:layout_marginBottom="16dp"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginBottom="20dp">
                <com.example.wifip2pchat.RadarView android:id="@+id/radarView"
                    android:layout_width="220dp" android:layout_height="220dp" android:layout_gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="YOU" android:textSize="11sp" android:textColor="@color/brand_secondary"
                    android:fontFamily="sans-serif-medium" android:letterSpacing="0.1" android:layout_gravity="center"/>
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/section_devices" android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/text_secondary" android:letterSpacing="0.08"
                android:textAllCaps="true" android:layout_marginBottom="8dp"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="220dp"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card" android:layout_marginBottom="12dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPeers"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:padding="6dp" android:clipToPadding="false" android:scrollbars="none"/>
                    <TextView android:id="@+id/tvPeersEmpty" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center"
                        android:text="No devices nearby yet.\nTap Discover to scan." android:textSize="13sp"
                        android:textColor="@color/text_tertiary" android:lineSpacingExtra="3dp" android:visibility="gone"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDiscover"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1.4"
                    android:layout_marginEnd="8dp" android:text="@string/btn_discover" android:textAllCaps="false"
                    android:textSize="13sp" android:textColor="@color/text_on_primary" android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="999dp"
                    app:backgroundTint="@color/brand_secondary" app:icon="@drawable/ic_search"
                    app:iconGravity="textStart" app:iconSize="18dp" app:iconTint="@color/text_on_primary"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDisconnect"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:text="@string/btn_disconnect" android:textAllCaps="false" android:textSize="13sp"
                    android:textColor="@color/brand_secondary" android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="999dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/brand_secondary" app:strokeWidth="1.5dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAudioCall"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:layout_marginEnd="8dp" android:text="@string/btn_audio_call" android:textAllCaps="false"
                    android:textSize="13sp" android:textColor="@color/text_on_primary" android:fontFamily="sans-serif-medium"
                    android:enabled="false" android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="999dp" app:backgroundTint="@color/brand_secondary"
                    app:icon="@drawable/ic_phone" app:iconGravity="textStart" app:iconSize="18dp"
                    app:iconTint="@color/text_on_primary"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnVideoCall"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:text="@string/btn_video_call" android:textAllCaps="false" android:textSize="13sp"
                    android:textColor="@color/text_on_primary" android:fontFamily="sans-serif-medium"
                    android:enabled="false" android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="999dp" app:backgroundTint="@color/brand_secondary"
                    app:icon="@drawable/ic_videocam" app:iconGravity="textStart" app:iconSize="18dp"
                    app:iconTint="@color/text_on_primary"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
