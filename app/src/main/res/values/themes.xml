<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.DisplayLarge" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Headline.Secondary" parent="TextAppearance.Headline">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Body.Secondary" parent="TextAppearance.Body">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Body.Small" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="Theme.Lanvox" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand_secondary</item>
        <item name="colorPrimaryVariant">@color/brand_secondary_variant</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_secondary_variant</item>
        <item name="colorOnSecondary">@color/text_on_secondary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/call_decline</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:colorBackground">@color/surface_background</item>
        <item name="android:statusBarColor">@color/brand_primary_variant</item>
        <item name="android:navigationBarColor">@color/brand_primary_variant</item>
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:scrollbars">none</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Lanvox.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.Lanvox.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Lanvox.BottomSheet</item>
        <item name="android:navigationBarColor">@color/brand_primary_variant</item>
    </style>

    <style name="Widget.Lanvox.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="Theme.Lanvox.Call" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand_secondary</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:windowBackground">@color/call_background</item>
        <item name="android:statusBarColor">@color/call_background</item>
        <item name="android:navigationBarColor">@color/call_background</item>
    </style>

    <style name="Theme.Lanvox.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand_secondary</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:windowBackground">@color/brand_primary</item>
        <item name="android:statusBarColor">@color/brand_primary_variant</item>
        <item name="android:navigationBarColor">@color/brand_primary_variant</item>
    </style>

    <style name="Widget.CallButton.Accept" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">@color/call_accept</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.CallButton.Decline" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">@color/call_decline</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.CallButton.Control" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="backgroundTint">@color/call_mute_bg</item>
        <item name="strokeColor">@color/brand_secondary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="Widget.ChatBubble.Sent" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bubble_sent</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.ChatBubble.Received" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bubble_received</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.AppCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">12dp</item>
    </style>

    <style name="CircleImageView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Circle</item>
    </style>

    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.PillButton.Call" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">999dp</item>
        <item name="backgroundTint">@color/pill_call_bg</item>
        <item name="android:textColor">@color/pill_call_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>

    <style name="Widget.PillButton.Video" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">999dp</item>
        <item name="strokeColor">@color/pill_video_border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/pill_video_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="backgroundTint">@color/pill_video_bg</item>
    </style>
</resources>
